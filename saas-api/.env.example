# PostgreSQL — recomandat: bază separată de chat (ex. thassos_saas pe Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/thassos_saas?sslmode=require

# SQLite local (doar dev):
# DATABASE_URL=sqlite:///./saas.db

PORT=8000

# Secret pentru POST /internal/grant-pro (Stripe Functions)
INTERNAL_API_SECRET=change-me-in-production

# Origini CORS separate prin virgulă (opțional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://greciaplanner.ro
